APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- May chu license ---------------------------------------------------------
# hmac | apikey | any
SEPAY_WEBHOOK_AUTH=hmac
SEPAY_WEBHOOK_SECRET=
SEPAY_WEBHOOK_TOKEN=
# API Access - CHI dung de doi soat, webhook khong can.
# Test mode: https://userapi-sandbox.sepay.vn | Live: https://userapi.sepay.vn
SEPAY_API_BASE=https://userapi-sandbox.sepay.vn
SEPAY_API_TOKEN=
SEPAY_ACCOUNT=
SEPAY_BANK=MB
SEPAY_ACCOUNT_NAME=

LICENSE_NOPAUSE_YEAR=200000
LICENSE_CODE_PREFIX=LX
LICENSE_MAX_DEVICES=3
# May lau khong thay mat thi nha suat cho may moi. 0 = tat.
# Khong nha thi nguoi mua that bi khoa o lan cai lai extension thu tu.
LICENSE_DEVICE_IDLE_DAYS=14
# Don chua tra song bao lau truoc khi bi don.
LICENSE_ORDER_TTL=60

# --- Ben ban, in tren bien nhan ----------------------------------------------
SELLER_NAME=
SELLER_EMAIL=
SELLER_SITE=
SELLER_TAX_CODE=
